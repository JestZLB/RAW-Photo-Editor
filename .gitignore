# ---- 依赖与构建产物 ----
node_modules/
dist/
target/
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/schemas/

# ---- 日志、临时文件与备份 ----
*.log
*.bak
*.tmp
.tmp-*
.codewiki/
.vite/

# ---- 编辑器与操作系统 ----
.DS_Store
Thumbs.db
Desktop.ini
.idea/
